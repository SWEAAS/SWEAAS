# ──────────────────────────────────────────────
# SWEAAS Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=SWEAAS Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=development

# ── Database (PostgreSQL) ────────────────────
DATABASE_URL=postgresql+asyncpg://sweaas:sweaas@localhost:5432/sweaas
DATABASE_POOL_SIZE=20

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase Auth ────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── GitHub App ───────────────────────────────
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-key.pem
GITHUB_ORG_NAME=SWEAAS
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── LiteLLM (Model Routing / Budget) ────────
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_API_BASE=http://localhost:4000
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ── E2B (Sandboxed Execution) ───────────────
E2B_API_KEY=e2b_your-api-key

# ── Sentry (Error Tracking) ─────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=sweaas

# ── Stripe (Payments) ───────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── AgentMail (Email for AI Agents) ─────────
AGENTMAIL_API_KEY=your-agentmail-api-key

# ── Tavus (Video Conferencing) ──────────────
TAVUS_API_KEY=your-tavus-api-key
TAVUS_REPLICA_ID=your-replica-id
TAVUS_PERSONA_ID=your-persona-id

# ── Golpo (Explainer Videos) ────────────────
GOLPO_API_KEY=your-golpo-api-key

# ── ChromaDB (Vector Store) ─────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── LangSmith (Agent Observability) ─────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=sweaas
