# ──────────────────────────────────────────────
# SWEAAS Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────
# dev@sweaas.dev
# ── Application ──────────────────────────────
APP_NAME=SWEAAS Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=development
# Comma-separated browser origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://sweaas.com,https://www.sweaas.com

# When true, require a valid Supabase JWT (ES256 via JWKS); requires SUPABASE_URL; disables /docs
AUTH_ENFORCE_JWT=false

# ── PostgreSQL (shared by docker-compose and backend)
POSTGRES_USER=sweaas
POSTGRES_PASSWORD=sweaas
POSTGRES_DB=sweaas
DATABASE_URL=postgresql+asyncpg://sweaas:sweaas@localhost:5432/sweaas
DATABASE_POOL_SIZE=20

# ── Frontend (Vite build-time variables) ─────
# Local dev (Docker nginx or Vite proxy): /api/v1
# Production (Amplify / CI): https://api.sweaas.com/api/v1
VITE_API_BASE_URL=/api/v1
# Sentry DSN for the React frontend (captures browser errors, traces, session replays)
VITE_SENTRY_DSN=

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase ─────────────────────────────────
# API keys: Dashboard → API Keys → Publishable + Secret (sb_publishable_… / sb_secret_…).
# User JWTs: verified with JWKS (ES256/RS256) — set SUPABASE_URL to https://<ref>.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Supabase CLI (supabase link, db push): https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── GitHub App ───────────────────────────────
# App ID and slug: github.com/organizations/SWEAAS/settings/apps/sweaashq
GITHUB_APP_ID=3188178
GITHUB_CLIENT_ID=                            # Iv23li... from GitHub App "About" section
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-key.pem
GITHUB_ORG_NAME=SWEAAS
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))" — paste same value in App settings webhook
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Local dev tunnel URL — create at https://smee.io and start with:
#   smee --url <URL> --target http://localhost:8000/api/v1/github/webhook
GITHUB_WEBHOOK_PROXY_URL=

# ── LLM ─────────────────────────────────────
# Direct calls via OpenAI / Anthropic SDKs (xAI uses OpenAI-compatible endpoint).
# Examples: xai/grok-3, xai/grok-2, gpt-4o-mini, claude-3-5-haiku-20241022
LLM_DEFAULT_MODEL=xai/grok-3
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# xAI Grok — used when LLM_DEFAULT_MODEL starts with xai/ (https://console.x.ai/)
XAI_API_KEY=

# ── E2B (Sandboxed Execution) ───────────────
E2B_API_KEY=e2b_your-api-key

# ── Sentry (Error Tracking + Per-Project Provisioning) ──
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=sweaas
# Team slug under which customer Sentry projects are auto-created (Settings > Teams)
SENTRY_TEAM=your-sentry-team

# ── Stripe (Payments + Connect) ──────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
# Local: `stripe listen --forward-to localhost:8000/api/v1/stripe/webhook` → paste printed whsec_... (new each session)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Platform fee charged on destination charges (percent, e.g. 10.0 = 10%)
STRIPE_PLATFORM_FEE_PERCENT=10.0
# Return URLs for Stripe Connect onboarding Account Links
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/revenue?stripe=complete
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/revenue?stripe=refresh

# ── AgentMail (Email for AI Agents) ─────────
AGENTMAIL_API_KEY=your-agentmail-api-key

# ── Tavus (Video Conferencing) ──────────────
TAVUS_API_KEY=your-tavus-api-key
TAVUS_REPLICA_ID=your-replica-id
TAVUS_PERSONA_ID=your-persona-id
# Optional: separate replica/persona for customer support video (end users)
TAVUS_CUSTOMER_REPLICA_ID=
TAVUS_CUSTOMER_PERSONA_ID=

# ── User feedback (fan-out to Slack/Zapier/internal worker)
FEEDBACK_WEBHOOK_URL=

# ── Twilio (optional — voice/SMS escalation for support)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Golpo (Explainer Videos) ────────────────
GOLPO_API_KEY=your-golpo-api-key

# ── Greptile (AI Code Review + Code Queries) ──
# Get your API key at https://app.greptile.com/api
# Auto-indexes repos on project creation; provides semantic code queries for agents
GREPTILE_API_KEY=
# Score threshold (0.0–1.0) above which PRs are auto-merged
GREPTILE_MERGE_THRESHOLD=0.8

# ── ChromaDB (Vector Store) ─────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ── LangSmith (Agent Observability) ─────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=sweaas

# ── Notifications / Communications ──────────
# Frontend URL used in notification links (e.g. "View in SWEAAS" links in emails)
APP_FRONTEND_URL=http://localhost:5173

# ── AWS / S3 (Production Infrastructure) ─────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-aws-account-id
# S3 bucket for onboarding docs and PDF reports
S3_BUCKET_NAME=sweaas-documents
# ECR: <account-id>.dkr.ecr.us-east-1.amazonaws.com/sweaas-backend
# ECS Cluster: sweaas  |  Services: backend, chromadb
# RDS endpoint: <instance>.cg3cksckkira.us-east-1.rds.amazonaws.com
# ElastiCache: sweaas-redis.<id>.0001.use1.cache.amazonaws.com:6379
# Amplify: sweaas.com (app id in Amplify console)
# Route 53: sweaas.com hosted zone → set Namecheap Custom DNS to Route 53 NS records
